<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicore.controller.PatientRecordsController"
      styleClass="screen" spacing="16">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <Label text="Patient Records" styleClass="screen-title"/>
    <Label text="Binary Search Tree — keyed by Patient ID, displayed via in-order traversal" styleClass="screen-subtitle"/>

    <VBox styleClass="panel-card" spacing="10">
        <Label text="Register new patient" styleClass="panel-title"/>
        <HBox spacing="8">
            <TextField fx:id="idField" promptText="Patient ID" prefWidth="100"/>
            <TextField fx:id="nameField" promptText="Name" prefWidth="180"/>
            <TextField fx:id="ageField" promptText="Age" prefWidth="70"/>
            <TextField fx:id="contactField" promptText="Contact number" prefWidth="150"/>
            <TextField fx:id="conditionField" promptText="Medical condition" prefWidth="200"/>
            <Button text="Insert" onAction="#handleInsert" styleClass="btn-primary"/>
        </HBox>
        <Label fx:id="formMessageLabel" styleClass="form-message"/>
    </VBox>

    <HBox spacing="8">
        <TextField fx:id="searchField" promptText="Search by Patient ID" prefWidth="200"/>
        <Button text="Search" onAction="#handleSearch"/>
        <Button text="Delete" onAction="#handleDelete" styleClass="btn-danger"/>
        <Button text="Refresh list" onAction="#handleRefresh"/>
    </HBox>

    <Label fx:id="searchResultLabel" styleClass="form-message"/>

    <ListView fx:id="patientListView" VBox.vgrow="ALWAYS" styleClass="preview-list"/>
</VBox>
