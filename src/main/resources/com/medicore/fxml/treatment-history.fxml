<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicore.controller.TreatmentHistoryController"
      styleClass="screen" spacing="16">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <Label text="Treatment History" styleClass="screen-title"/>
    <Label text="LIFO — most recently completed treatment is shown first" styleClass="screen-subtitle"/>

    <HBox spacing="8">
        <TextField fx:id="patientIdField" promptText="Patient ID" prefWidth="120"/>
        <TextField fx:id="summaryField" promptText="Treatment summary" prefWidth="260"/>
        <Button text="Complete treatment (Push)" onAction="#handlePush" styleClass="btn-primary"/>
        <Button text="Undo last (Pop)" onAction="#handlePop" styleClass="btn-danger"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="form-message"/>

    <ListView fx:id="stackListView" VBox.vgrow="ALWAYS" styleClass="preview-list"/>
</VBox>
