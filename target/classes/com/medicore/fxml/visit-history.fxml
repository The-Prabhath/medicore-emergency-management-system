<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicore.controller.VisitHistoryController"
      styleClass="screen" spacing="16">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <Label text="Visit History" styleClass="screen-title"/>
    <Label text="Singly Linked List — one chronological chain per patient" styleClass="screen-subtitle"/>

    <HBox spacing="8">
        <TextField fx:id="patientIdField" promptText="Patient ID" prefWidth="100"/>
        <Button text="Load history" onAction="#handleLoad"/>
    </HBox>

    <HBox spacing="8">
        <TextField fx:id="doctorField" promptText="Doctor name" prefWidth="160"/>
        <TextField fx:id="diagnosisField" promptText="Diagnosis" prefWidth="180"/>
        <TextField fx:id="treatmentField" promptText="Treatment" prefWidth="180"/>
        <Button text="Add visit" onAction="#handleAddVisit" styleClass="btn-primary"/>
    </HBox>

    <HBox spacing="8">
        <TextField fx:id="visitIdField" promptText="Visit ID" prefWidth="100"/>
        <Button text="Search visit" onAction="#handleSearchVisit"/>
        <Button text="Remove visit" onAction="#handleRemoveVisit" styleClass="btn-danger"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="form-message"/>

    <ListView fx:id="visitListView" VBox.vgrow="ALWAYS" styleClass="preview-list"/>
</VBox>
